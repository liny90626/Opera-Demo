# Copy to .env (git-ignored). Loaded by apps/server at startup; real environment variables win.
# Akubela GRMS integration (see docs/07-akubela-integration-design.md)
# AKUBELA_MODE=real            # real | sim | off  (default: real if id+secret set, else sim)
AKUBELA_BASE_URL=https://api.cbcloud.uat.akubela.com
# AKUBELA_CLIENT_ID=your-client-id         # set both to enable real mode
# AKUBELA_CLIENT_SECRET=your-client-secret
AKUBELA_HOTEL_TZ=Asia/Shanghai
# Manual room mapping "operaRoom:grmsRoomNo,..." (default: match by room number)
# AKUBELA_ROOM_MAP=201:101,202:102
AKUBELA_POLL_SECONDS=20
